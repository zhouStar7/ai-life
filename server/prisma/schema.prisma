generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Profile {
  id        String @id
  name      String
  modelBase String @default("")
  modelName String @default("")
  modelKey  String @default("")
  haBase    String @default("")
  haToken   String @default("")
}

model Member {
  id           String @id
  username     String @unique
  name         String
  passwordHash String
  createdAt    String
}

model AuthSession {
  token     String @id
  memberId  String
  expiresAt String
}

model MutationReceipt {
  memberId  String
  key       String
  signature String
  status    Int
  response  String
  createdAt DateTime @default(now())

  @@id([memberId, key])
}

model ActionRun {
  id          String @id
  fingerprint String @unique
  type        String
  status      String
  detail      String @default("")
}

model MemberState {
  memberId        String  @id
  suggestionIndex Int     @default(0)
  outfitAdopted   Boolean @default(false)
  activeOutfitId  String?
  activeTripId    String  @default("")
  adoptedTips     String  @default("[]")
}

model SessionState {
  id               String  @id
  weatherOn        Boolean @default(true)
  weatherLabel     String  @default("22°C 多云")
  weatherCity      String  @default("")
  weatherSource    String  @default("")
  weatherUpdatedAt String  @default("")
  activeScene      String?
  haConnected      Boolean @default(false)
  haScenes         String  @default("{}")
}

model WardrobeItem {
  id         String  @id
  memberId   String  @default("local")
  name       String
  category   String
  season     String
  color      String
  occasion   String
  wears      Int
  createdAt  String
  cover      String  @default("")
  priceCents BigInt?

  @@index([memberId, createdAt])
}

model WardrobePhoto {
  id       String @id
  memberId String @default("local")
  data     String
}

model Outfit {
  id       String  @id
  memberId String  @default("local")
  name     String
  itemIds  String
  favorite Boolean

  @@index([memberId])
}

model Meal {
  id       String @id
  memberId String @default("local")
  slot     String
  name     String
  time     String
  date     String
  kcal     Int
  protein  Int
  carb     Int
  fat      Int

  @@index([memberId])
}

model Recipe {
  id       String @id
  memberId String @default("local")
  name     String
  tags     String
  slot     String
  kcal     Int
  protein  Int
  carb     Int
  fat      Int

  @@index([memberId])
}

model NutritionTarget {
  id       String @id
  memberId String @unique @default("local")
  kcal     Int
  protein  Int
  carb     Int
  fat      Int
}

model Device {
  id         String  @id
  name       String
  room       String
  kind       String
  on         Boolean
  paramLabel String?
  paramValue String?
  offline    Boolean @default(false)
  source     String  @default("demo")
}

model Alert {
  id      String  @id
  level   String
  title   String
  detail  String
  handled Boolean @default(false)
}

model Trip {
  id          String  @id
  memberId    String  @default("local")
  title       String
  status      String
  transport   String
  dateLabel   String
  startDate   String?
  endDate     String?
  tickets     String
  timeline    String
  packing     String
  prepAdopted Boolean @default(false)

  @@index([memberId])
}

model Expense {
  id          String      @id
  memberId    String      @default("local")
  tag         String
  amountCents BigInt
  date        String
  merchant    String
  note        String
  tripId      String      @default("")
  fingerprint String?
  billImport  BillImport?

  @@unique([memberId, id])
  @@unique([memberId, fingerprint])
  @@index([memberId, date, id])
  @@index([memberId, tripId])
}

model BillImport {
  expenseId     String
  memberId      String  @default("local")
  expense       Expense @relation(fields: [memberId, expenseId], references: [memberId, id], onDelete: Cascade)
  source        String
  rowKey        String?
  platformKey   String?
  transactionId String?

  @@id([memberId, expenseId])
  @@unique([memberId, rowKey])
  @@unique([memberId, platformKey])
}

model PackingTemplate {
  id       String @id
  memberId String @default("local")
  name     String
  items    String

  @@index([memberId])
}

model Budget {
  id         String @id
  memberId   String @unique @default("local")
  totalCents BigInt
  clothCents BigInt
  foodCents  BigInt
  homeCents  BigInt
  tripCents  BigInt
}

model Notice {
  id       String  @id
  memberId String  @unique @default("local")
  outfit   Boolean
  budget   Boolean
  device   Boolean
}

model QuickMealDraft {
  id         String   @id @default(uuid())
  memberId   String   @default("local")
  requestId  String   @unique
  text       String
  date       String
  status     String   @default("pending")
  receivedAt DateTime @default(now())
}
