generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Profile {
  id        String @id
  name      String
  modelBase String @default("")
  modelName String @default("")
  modelKey  String @default("")
  haBase     String  @default("")
  haToken    String  @default("")
  moneyCents Boolean @default(false)
}

model Member {
  id           String @id
  username     String @unique
  name         String
  passwordHash String
  createdAt    String
}

model AuthSession {
  token     String @id
  memberId  String
  expiresAt String
}

model MemberState {
  memberId        String  @id
  suggestionIndex Int     @default(0)
  outfitAdopted   Boolean @default(false)
  activeOutfitId  String?
  activeTripId    String  @default("")
  adoptedTips     String  @default("[]")
}

model SessionState {
  id              String  @id
  suggestionIndex Int     @default(0)
  weatherOn       Boolean @default(true)
  weatherLabel    String  @default("22°C 多云")
  outfitAdopted   Boolean @default(false)
  activeOutfitId  String?
  activeScene     String?
  activeTripId    String  @default("t-bj")
  adoptedTips     String  @default("[]")
  haConnected     Boolean @default(false)
  haScenes        String  @default("{}")
}

model WardrobeItem {
  id        String @id
  memberId  String @default("m-xingyu")
  name      String
  category  String
  season    String
  color     String
  occasion  String
  wears     Int
  createdAt String
  cover     String @default("")
  priceCents Int?

  @@index([memberId, createdAt])
}

model Outfit {
  id       String  @id
  memberId String  @default("m-xingyu")
  name     String
  itemIds  String
  favorite Boolean
}

model Meal {
  id       String @id
  memberId String @default("m-xingyu")
  slot     String
  name     String
  time     String
  date     String @default("2026-09-22")
  kcal     Int
  protein  Int
  carb     Int
  fat      Int
}

model Recipe {
  id       String @id
  memberId String @default("m-xingyu")
  name     String
  tags     String
  slot     String
  kcal     Int
  protein  Int
  carb     Int
  fat      Int
}

model NutritionTarget {
  id       String @id
  memberId String @unique @default("m-xingyu")
  kcal     Int
  protein  Int
  carb     Int
  fat      Int
}

model Device {
  id         String  @id
  name       String
  room       String
  kind       String
  on         Boolean
  paramLabel String?
  paramValue String?
  offline    Boolean @default(false)
  source     String  @default("demo")
}

model Alert {
  id      String  @id
  level   String
  title   String
  detail  String
  handled Boolean @default(false)
}

model Trip {
  id          String  @id
  memberId    String  @default("m-xingyu")
  title       String
  status      String
  transport   String
  dateLabel   String
  startDate   String?
  endDate     String?
  tickets     String
  timeline    String
  packing     String
  prepAdopted Boolean @default(false)
}

model Expense {
  id          String  @id
  memberId    String  @default("m-xingyu")
  tag         String
  amount      Int
  date        String
  merchant    String
  note        String
  tripId      String  @default("")
  fingerprint String?

  @@index([memberId, date, id])
  @@index([memberId, tripId])

  @@unique([memberId, fingerprint])
}

model ActionRun {
  id          String @id
  fingerprint String @unique
  type        String
  status      String
  detail      String @default("")
}

model PackingTemplate {
  id       String @id
  memberId String @default("m-xingyu")
  name     String
  items    String
}

model Budget {
  id       String @id
  memberId String @unique @default("m-xingyu")
  total    Int
  cloth    Int
  food     Int
  home     Int
  trip     Int
}

model Notice {
  id       String  @id
  memberId String  @unique @default("m-xingyu")
  outfit   Boolean
  budget   Boolean
  device   Boolean
}

model MutationReceipt {
  memberId String
  key String
  signature String
  status Int
  response String
  createdAt DateTime @default(now())
  @@id([memberId, key])
}

model WardrobePhoto {
  id String @id
  data String
}
